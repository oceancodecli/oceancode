{
  "name": "oceancode",
  "version": "0.1.2",
  "description": "Next-generation CLI coding assistant with free models, BYOK, MCP ecosystem, and autonomous agent loops",
  "main": "dist/index.js",
  "bin": {
    "oceancode": "dist/index.js",
    "ocean": "dist/index.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceancodecli/oceancode.git"
  },
  "homepage": "https://github.com/oceancodecli/oceancode#readme",
  "bugs": {
    "url": "https://github.com/oceancodecli/oceancode/issues"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "terminal",
    "coding-assistant",
    "developer-tools",
    "opencode",
    "oceancode",
    "mcp",
    "model-context-protocol",
    "byok",
    "autonomous-agent",
    "deepseek",
    "anthropic",
    "openai",
    "gemini"
  ],
  "author": "Veloxx Labs <https://github.com/Veloxx-Labs>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "opencode-ai": "^1.18.29",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
