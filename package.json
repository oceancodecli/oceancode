{
  "name": "oceancode",
  "version": "0.1.1",
  "description": "Next-generation CLI coding assistant powered by OpenCode server",
  "main": "dist/index.js",
  "bin": {
    "oceancode": "dist/index.js",
    "ocean": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-assistant",
    "opencode",
    "oceancode"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "opencode-ai": "^1.18.29",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
